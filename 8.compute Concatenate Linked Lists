#include <iostream>
using namespace std;

struct node {
    int prn;
    char name[30];
    node *next;
};

void club() {
    node *head1 = NULL, *head2 = NULL;
    node *temp, *newnode;
    int n, i, count = 0;

    // First Division
    cout << "Enter members in Division 1: ";
    cin >> n;

    for (i = 0; i < n; i++) {
        newnode = new node;
        cout << "Enter PRN and Name: ";
        cin >> newnode->prn >> newnode->name;
        newnode->next = NULL;

        if (head1 == NULL)
            head1 = newnode;
        else {
            temp = head1;
            while (temp->next != NULL)
                temp = temp->next;
            temp->next = newnode;
        }
    }

    // Second Division
    cout << "Enter members in Division 2: ";
    cin >> n;

    for (i = 0; i < n; i++) {
        newnode = new node;
        cout << "Enter PRN and Name: ";
        cin >> newnode->prn >> newnode->name;
        newnode->next = NULL;

        if (head2 == NULL)
            head2 = newnode;
        else {
            temp = head2;
            while (temp->next != NULL)
                temp = temp->next;
            temp->next = newnode;
        }
    }

    // Concatenate two lists
    if (head1 == NULL)
        head1 = head2;
    else {
        temp = head1;
        while (temp->next != NULL)
            temp = temp->next;
        temp->next = head2;
    }

    // Display and Count
    cout << "\nCombined Club Members:\n";
    temp = head1;

    while (temp != NULL) {
        cout << temp->prn << " " << temp->name << endl;
        count++;
        temp = temp->next;
    }

    cout << "Total Members: " << count;
}

int main() {
    club();
    return 0;
}

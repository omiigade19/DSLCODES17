#include<iostream>
using namespace std;

int main()
{
    int a[20],n,i,ch,key,count;
    int low,high,mid;

    cout<<"Enter number of students: ";
    cin>>n;

    cout<<"Enter roll numbers in sorted order: ";
    for(i=0;i<n;i++)
        cin>>a[i];

    do
    {
        cout<<"\n1. Linear Search";
        cout<<"\n2. Binary Search";
        cout<<"\n3. Exit";
        cout<<"\nEnter choice: ";
        cin>>ch;

        if(ch==1)
        {
            cout<<"Enter roll number: ";
            cin>>key;

            count=0;

            for(i=0;i<n;i++)
            {
                count++;

                if(a[i]==key)
                    break;
            }

            if(i<n)
                cout<<"Roll number found";
            else
                cout<<"Roll number not found";

            cout<<"\nComparisons: "<<count;
        }

        else if(ch==2)
        {
            cout<<"Enter roll number: ";
            cin>>key;

            low=0;
            high=n-1;
            count=0;

            while(low<=high)
            {
                mid=(low+high)/2;
                count++;

                if(a[mid]==key)
                    break;
                else if(key>a[mid])
                    low=mid+1;
                else
                    high=mid-1;
            }

            if(low<=high)
                cout<<"Roll number found";
            else
                cout<<"Roll number not found";

            cout<<"\nComparisons: "<<count;
        }

    }while(ch!=3);

    return 0;
}

#include <iostream>
using namespace std;

struct node {
    int prn;
    char name[30];
    node *next;
};

void club() {
    node *head = NULL, *temp, *newnode;
    int n, i, count = 0;

    // Add President
    newnode = new node;

    cout << "Enter President PRN and Name: ";
    cin >> newnode->prn >> newnode->name;

    newnode->next = NULL;
    head = newnode;

    // Add Members
    cout << "Enter number of members: ";
    cin >> n;

    for (i = 0; i < n; i++) {
        newnode = new node;

        cout << "Enter PRN and Name: ";
        cin >> newnode->prn >> newnode->name;

        newnode->next = NULL;

        temp = head;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newnode;
    }

    // Add Secretary
    newnode = new node;

    cout << "Enter Secretary PRN and Name: ";
    cin >> newnode->prn >> newnode->name;

    newnode->next = NULL;

    temp = head;

    while (temp->next != NULL) {
        temp = temp->next;
    }

    temp->next = newnode;

    // Display Members
    cout << "\nClub Members:\n";

    temp = head;

    while (temp != NULL) {
        cout << temp->prn << " " << temp->name << endl;
        count++;
        temp = temp->next;
    }

    cout << "Total Members: " << count;
}

int main() {
    club();
    return 0;
}

#include <iostream>
using namespace std;

int main()
{
    int hash[10], n, key, index;

    for(int i = 0; i < 10; i++)
        hash[i] = -1;

    cout << "Enter number of clients: ";
    cin >> n;

    for(int i = 0; i < n; i++)
    {
        cout << "Enter telephone number: ";
        cin >> key;

        index = key % 10;

        int j = 0;

        while(hash[(index + j*j) % 10] != -1)
        {
            j++;
        }

        hash[(index + j*j) % 10] = key;
    }

    cout << "\nHash Table:\n";

    for(int i = 0; i < 10; i++)
        cout << i << " -> " << hash[i] << endl;

    cout << "\nEnter telephone number to search: ";
    cin >> key;

    index = key % 10;

    int j = 0;

    while(j < 10)
    {
        int pos = (index + j*j) % 10;

        if(hash[pos] == key)
        {
            cout << "Number found at index " << pos;
            return 0;
        }

        if(hash[pos] == -1)
            break;

        j++;
    }

    cout << "Number not found";

    return 0;
}

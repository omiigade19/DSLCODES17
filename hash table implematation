#include <iostream>
using namespace std;

int main()
{
    int hash[10], n, key, index;

    for(int i = 0; i < 10; i++)
        hash[i] = -1;

    cout << "Enter number of clients: ";
    cin >> n;

    for(int i = 0; i < n; i++)
    {
        cout << "Enter telephone number: ";
        cin >> key;

        index = key % 10;

        while(hash[index] != -1)
        {
            index = (index + 1) % 10;
        }

        hash[index] = key;
    }

    cout << "\nHash Table:\n";

    for(int i = 0; i < 10; i++)
        cout << i << " -> " << hash[i] << endl;

    cout << "\nEnter telephone number to search: ";
    cin >> key;

    index = key % 10;

    while(hash[index] != -1)
    {
        if(hash[index] == key)
        {
            cout << "Number found at index " << index;
            return 0;
        }

        index = (index + 1) % 10;
    }

    cout << "Number not found";

    return 0;
}

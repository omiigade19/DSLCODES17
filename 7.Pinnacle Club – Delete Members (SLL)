#include <iostream>
using namespace std;

struct node {
    int prn;
    char name[30];
    node *next;
};

void club() {
    node *head = NULL, *temp, *newnode, *prev;
    int n, i, key, count = 0;

    // Create President
    newnode = new node;
    cout << "Enter President PRN and Name: ";
    cin >> newnode->prn >> newnode->name;

    newnode->next = NULL;
    head = newnode;

    // Create Members
    cout << "Enter number of members: ";
    cin >> n;

    for (i = 0; i < n; i++) {
        newnode = new node;

        cout << "Enter PRN and Name: ";
        cin >> newnode->prn >> newnode->name;

        newnode->next = NULL;
        temp = head;

        while (temp->next != NULL)
            temp = temp->next;

        temp->next = newnode;
    }

    // Create Secretary
    newnode = new node;

    cout << "Enter Secretary PRN and Name: ";
    cin >> newnode->prn >> newnode->name;

    newnode->next = NULL;
    temp = head;

    while (temp->next != NULL)
        temp = temp->next;

    temp->next = newnode;

    // Delete Member
    cout << "\nEnter PRN to delete: ";
    cin >> key;

    temp = head;
    prev = NULL;

    while (temp != NULL && temp->prn != key) {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Member Not Found";
    }
    else {
        if (prev == NULL)
            head = temp->next;
        else
            prev->next = temp->next;

        delete temp;
        cout << "Member Deleted";
    }

    // Display Members
    cout << "\n\nClub Members:\n";

    temp = head;

    while (temp != NULL) {
        cout << temp->prn << " " << temp->name << endl;
        count++;
        temp = temp->next;
    }

    cout << "Total Members: " << count;
}

int main() {
    club();
    return 0;
}

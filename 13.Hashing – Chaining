#include <iostream>
using namespace std;

struct node
{
    int data;
    node *next;
};

int main()
{
    node *hash[10] = {NULL};
    int n, key, index;

    cout << "Enter number of elements: ";
    cin >> n;

    for(int i = 0; i < n; i++)
    {
        cout << "Enter element: ";
        cin >> key;

        index = key % 10;

        node *temp = new node;
        temp->data = key;
        temp->next = hash[index];

        hash[index] = temp;
    }

    cout << "\nHash Table:\n";

    for(int i = 0; i < 10; i++)
    {
        cout << i << " -> ";

        node *temp = hash[i];

        while(temp != NULL)
        {
            cout << temp->data << " -> ";
            temp = temp->next;
        }

        cout << "NULL\n";
    }

    cout << "\nEnter element to search: ";
    cin >> key;

    index = key % 10;

    node *temp = hash[index];

    while(temp != NULL)
    {
        if(temp->data == key)
        {
            cout << "Element found";
            return 0;
        }

        temp = temp->next;
    }

    cout << "Element not found";

    return 0;
}

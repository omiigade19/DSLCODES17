#include<iostream>
using namespace std;

int main()
{
    int q[20], front=-1, rear=-1;
    int ch, job;

    do
    {
        cout<<"\n1. Add Job";
        cout<<"\n2. Delete Job";
        cout<<"\n3. Display Queue";
        cout<<"\n4. Exit";
        cout<<"\nEnter choice: ";
        cin>>ch;

        if(ch==1)
        {
            if(rear==19)
                cout<<"Queue is full";
            else
            {
                cout<<"Enter job ID: ";
                cin>>job;

                if(front==-1)
                    front=0;

                rear++;
                q[rear]=job;

                cout<<"Job added";
            }
        }

        else if(ch==2)
        {
            if(front==-1 || front>rear)
                cout<<"Queue is empty";
            else
            {
                cout<<"Deleted job: "<<q[front];
                front++;

                if(front>rear)
                {
                    front=-1;
                    rear=-1;
                }
            }
        }

        else if(ch==3)
        {
            if(front==-1)
                cout<<"Queue is empty";
            else
            {
                cout<<"Jobs in queue: ";
                for(int i=front;i<=rear;i++)
                    cout<<q[i]<<" ";
            }
        }

    }while(ch!=4);

    return 0;
}
